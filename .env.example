# ============================================================================
# Environment Variables - Mobile Template
# ============================================================================
# העתק קובץ זה ל-.env והחלף את הערכים שלך
# Copy this file to .env and replace with your values
#
# קובץ .env לא עולה ל-Git (נמצא ב-.gitignore)
# .env files are gitignored for security

# ============================================================================
# Convex (חובה / Required)
# ============================================================================
# נוצר אוטומטית כשמריצים: bunx convex dev
# Auto-generated when running: bunx convex dev

CONVEX_DEPLOYMENT=dev:your-project-name-123
EXPO_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# הערה: Convex יוצר NEXT_PUBLIC_CONVEX_URL אבל האפליקציה משתמשת ב-EXPO_PUBLIC
# Note: Convex creates NEXT_PUBLIC_CONVEX_URL but the app uses EXPO_PUBLIC

# ============================================================================
# AI Generation (חובה / Required)
# ============================================================================
# OpenAI is used for captions, business analysis, photo mode, and complete
# designed/premium_ad poster image generation.

OPENAI_API_KEY=sk-...
# Poster image model. GPT Image 2 is the current state-of-the-art OpenAI image
# model for premium API image generation.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional: english is safest for image-rendered poster text. Set to hebrew
# when you want to test Hebrew text rendering inside the generated image.
OPENAI_POSTER_LANGUAGE_MODE=english

# ============================================================================
# AI Quality Boost (אופציונלי / Optional)
# ============================================================================
# When enabled, the poster generation pipeline produces AI_CANDIDATE_COUNT
# posters in parallel with slight composition variations, then uses GPT-4o
# (vision) to automatically select the best one. The user always receives
# exactly ONE poster — only the winner is returned.
#
# These Convex-side vars must be set via the Convex dashboard or CLI:
#   npx convex env set AI_QUALITY_MODE true
#   npx convex env set AI_CANDIDATE_COUNT 3
#
# Note: Quality Boost increases generation time and OpenAI API cost ~3×.
# AI_QUALITY_MODE=false        (default — existing single-generation flow)
# AI_CANDIDATE_COUNT=3         (2–5; more = higher quality ceiling, higher cost)
#
# Mirror in .env for the client-side loading copy (no logic effect):
# EXPO_PUBLIC_AI_QUALITY_MODE=false

# ============================================================================
# RevenueCat - מערכת תשלומים (אופציונלי / Optional)
# ============================================================================
# נדרש רק אם אתם משתמשים במערכת התשלומים
# Only required if using the payment system
# ראה docs/REVENUECAT_SETUP.md להוראות מלאות

# Test Store API Key (לבדיקות בפיתוח בלבד)
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_...

# Production API Keys (לפלטפורמה ספציפית)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# ============================================================================
# Legal URLs - קישורים משפטיים (אופציונלי / Optional)
# ============================================================================
# אם לא מוגדר, ישתמש בברירות מחדל מ-config/legalUrls.ts
# If not set, will use defaults from config/legalUrls.ts

# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://docs.google.com/document/d/12NuX5iPw1qVLcbe3_XVPiVseot2YxiXgiSn7vJq--CE/edit?usp=sharing
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://docs.google.com/document/d/1MItfjzwqCUCRHeyggID3fvmNE1NvP6JNk_igNM9gozo/edit?usp=sharing
